# Grafana Cloud OTLP ingest (HTTP Basic: instance id = user, token = password)
GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
GRAFANA_OTLP_INSTANCE_ID=000000
GRAFANA_OTLP_TOKEN=glc_replace_me

# Grafana Cloud read API, used by the mcp-grafana server
GRAFANA_URL=https://<your-stack>.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_replace_me

# Gemini. Two interchangeable backends, selected by GOOGLE_GENAI_USE_VERTEXAI.
#   false -> Gemini Developer API (AI Studio): set GOOGLE_API_KEY
#   true  -> Vertex AI: set GOOGLE_CLOUD_PROJECT and authenticate with ADC
GOOGLE_API_KEY=your-aistudio-api-key
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
